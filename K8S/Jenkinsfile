pipeline {
    agent any

    tools {
        jdk 'jdk-17'
        nodejs 'Node16'
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Target Kubernetes Environment / Namespace')
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to deploy')
        booleanParam(name: 'ENABLE_SECURITY_SCANS', defaultValue: true, description: 'Execute SonarQube, OWASP and Trivy DevSecOps scans')
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        DOCKER_IMAGE = "thakurayushsingh/hotstar:${params.IMAGE_TAG}"
        REPO_URL     = 'https://github.com/thakurayushsingh/hotstar-clone.git'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Git Checkout') {
            steps {
                git branch: 'main', url: "${env.REPO_URL}"
            }
        }

        stage('SonarQube Code Quality Analysis') {
            when {
                expression { return params.ENABLE_SECURITY_SCANS }
            }
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh """
                        $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.projectName=Disney-Hotstar-Kubernetes \
                        -Dsonar.projectKey=hotstar-k8s
                    """
                }
            }
        }

        stage('Quality Gate') {
            when {
                expression { return params.ENABLE_SECURITY_SCANS }
            }
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'Sonar-token'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('OWASP Dependency-Check') {
            when {
                expression { return params.ENABLE_SECURITY_SCANS }
            }
            steps {
                dependencyCheck additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit', odcInstallation: 'DP'
                dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
            }
        }

        stage('Trivy Filesystem Scan') {
            when {
                expression { return params.ENABLE_SECURITY_SCANS }
            }
            steps {
                sh 'trivy fs --severity HIGH,CRITICAL . > trivyfs.txt || true'
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                        sh "docker build -t ${env.DOCKER_IMAGE} ."
                        sh "docker push ${env.DOCKER_IMAGE}"
                    }
                }
            }
        }

        stage('Trivy Image Vulnerability Scan') {
            when {
                expression { return params.ENABLE_SECURITY_SCANS }
            }
            steps {
                sh "trivy image --severity HIGH,CRITICAL ${env.DOCKER_IMAGE} > trivyimage.txt || true"
            }
        }

        stage('Deploy to Kubernetes Cluster') {
            steps {
                sh 'kubectl apply -f K8S/manifest.yml'
                sh 'kubectl rollout status deployment/hotstar-deployment --timeout=120s || true'
            }
        }
    }

    post {
        always {
            script {
                def buildStatus = currentBuild.currentResult
                echo "Kubernetes Pipeline finished with status: ${buildStatus} for Environment: ${params.ENVIRONMENT}"

                try {
                    slackSend(
                        channel: '#devops-deployments',
                        color: buildStatus == 'SUCCESS' ? '#00FF00' : '#FF0000',
                        message: "Disney+ Hotstar Kubernetes Pipeline: ${buildStatus} - Job ${env.JOB_NAME} #${env.BUILD_NUMBER}"
                    )
                } catch (Exception e) {
                    echo "Slack notification skipped or plugin not configured."
                }
            }
        }
    }
}
